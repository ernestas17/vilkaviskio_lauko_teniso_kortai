# Server
PORT=4000
# Public base URL of the CLIENT app — used to build the email confirm/cancel links.
CLIENT_BASE_URL=http://localhost:5173

# Database — SQLite path, resolved relative to the server/ directory.
DATABASE_URL=file:./prisma/dev.db

# Email (SMTP). Port 465 = implicit TLS; otherwise STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=Vilkaviškio lauko teniso kortai <no-reply@example.com>

# Admin bootstrap — read only by `npm run admin:create` (password hashed at seed time).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Secret for signing admin session cookies (use a long random string).
JWT_SECRET=replace-with-a-long-random-secret
