# Server
PORT=4000
# Set to "production" on the deployed server — required so the admin session
# cookie is sent cross-site (SameSite=None; Secure).
NODE_ENV=production
# Public URL of the CLIENT app — used for email confirm/cancel links AND as an
# allowed CORS origin. Add extra allowed origins (comma-separated) via CORS_ORIGINS.
CLIENT_BASE_URL=https://vilkaviskiolaukotenisokortai.lt
# CORS_ORIGINS=https://another-origin.example.com

# Database — MySQL connection string. URL-encode special characters in the
# password (e.g. "/" → "%2F").
DATABASE_URL=mysql://user:password@host:3306/database

# Email (SMTP). Port 465 = implicit TLS; otherwise STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=Vilkaviškio lauko teniso kortai <no-reply@example.com>

# Admin bootstrap — read only by `npm run admin:create` (password hashed at seed time).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Secret for signing admin session cookies (use a long random string).
JWT_SECRET=replace-with-a-long-random-secret
