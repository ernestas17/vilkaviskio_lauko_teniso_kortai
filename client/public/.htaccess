# SPA history fallback: serve index.html for client-side routes (React Router),
# so deep links like /admin/login or /confirm/:token work on direct load/refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories (assets, images, etc.) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → index.html (the SPA handles routing).
  RewriteRule ^ index.html [L]
</IfModule>
